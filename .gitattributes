# Auto detect text files and normalize line endings to LF
* text=auto eol=lf
*.sln text eol=crlf

# Text files
*.cs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.class binary

# Denormalize binary files in Git diffs
*.exe -text
*.dll -text
*.class -text
